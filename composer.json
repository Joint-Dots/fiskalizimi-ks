{
    "name": "jointdots/fiskalizimi-ks",
    "description": "Kosovo ATK SEF fiscalization integration for Laravel",
    "type": "library",
    "homepage": "https://github.com/jointdots/fiskalizimi-ks",
    "keywords": [
        "atk",
        "fiscalization",
        "kosovo",
        "laravel",
        "sef"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/jointdots/fiskalizimi-ks/issues",
        "source": "https://github.com/jointdots/fiskalizimi-ks"
    },
    "require": {
        "php": "^8.2",
        "ext-openssl": "*",
        "google/protobuf": "^4.0|^5.0",
        "guzzlehttp/guzzle": "^7.0",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Jointdots\\FiskalizimiKs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jointdots\\FiskalizimiKs\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jointdots\\FiskalizimiKs\\FiskalizimiServiceProvider"
            ],
            "aliases": {
                "Fiscalizer": "Jointdots\\FiskalizimiKs\\Facades\\Fiscalizer"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
